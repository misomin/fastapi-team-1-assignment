# Copy to /home/ubuntu/wapang/shared/production.env on EC2, mode 600.
# This file is an example. Never commit the real production.env.
# ENV is set to prod by both the deployment script and the systemd service.
DB_DIALECT=mysql
DB_DRIVER=pymysql
DB_HOST=replace-with-rds-endpoint.rds.amazonaws.com
DB_PORT=3306
DB_USER=replace-with-db-user
DB_PASSWORD=replace-with-db-password
DB_DATABASE=wapang
ACCESS_TOKEN_SECRET=replace-with-access-token-secret
REFRESH_TOKEN_SECRET=replace-with-refresh-token-secret
SHORT_SESSION_LIFESPAN=15
LONG_SESSION_LIFESPAN=1440
